{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BetterLGTM",
  "version": "0.5.0",
  "identifier": "io.weekone.betterlgtm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BetterLGTM",
        "width": 1440,
        "height": 900,
        "minWidth": 480,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJFODIxNEQ1RjYyQjgwMDMKUldRRGdDdjIxUlNDdnJMc0YrOFJnclY1amRRaEg5WU5WQnd4bUdvUFdlbDlTYjB6bURYeUpTLzIK",
      "endpoints": [
        "https://drmas.github.io/betterlgtm/latest.json",
        "https://github.com/drmas/betterlgtm/releases/latest/download/latest.json"
      ]
    }
  }
}
